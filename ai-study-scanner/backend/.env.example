# AI Study Scanner - Backend environment variables (example)
# Copy to `.env` and fill in values for your environment.

# Application
ENV=production
LOG_LEVEL=info

# AI provider: Groq (do not commit real keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning models spend tokens thinking; "low" keeps answers inside the budgets. "" omits it.
GROQ_REASONING_EFFORT=low

# --- UPSC Live Agent (current-affairs push) ---
# Comma-separated RSS feeds (optional; sensible defaults are built in).
# NEWS_RSS_FEEDS=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3,https://www.thehindu.com/news/national/feeder/default.rss

# Secret that protects POST /cron/dispatch. Generate a long random string and
# give the same value to whatever calls the cron endpoint (cron-job.org, etc).
CRON_SECRET=change_me_to_a_long_random_string

# Firebase service-account JSON (one line) for sending FCM push + reading the
# subscriptions in Firestore. Get it from Firebase console > Project settings >
# Service accounts > Generate new private key. Paste the whole JSON as a string.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}

# Math OCR for Pro scans (Mathpix, $0.002/image). Leave unset to keep on-device OCR only.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
OCR_MAX_IMAGE_BYTES=3145728
OCR_RATE_LIMIT=6/minute
