<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      AD_ID is contributed by play-services-ads and is required for personalised
      rewarded ads. It was previously removed (no ads shipped); restoring it means
      the Play Data safety form must declare Advertising ID collection.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />


    <application
        android:name=".AIStudyScannerApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:label="AI Study Scan Agent"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIStudyScanner">

        <!-- Disable Sentry auto-init so AIStudyScannerApplication controls it (only when DSN is set) -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!--
          At targetSdk 36 Android ignores screenOrientation on displays >= 600dp.
          Keep the portrait lock for now; this opt-out stops working in API 37, so
          proper adaptive layouts are the real follow-up.
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <!-- AdMob App ID (AI Study Scan Agent, linked 2026-07-29) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9538633548349202~9093067559" />

        <!-- UPSC Live Agent — FCM push receiver -->
        <service
            android:name=".messaging.StudyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="upsc_live_agent" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
